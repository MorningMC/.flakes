# Top-most EditorConfig file
root = true

[*]
# Apply POSIX compliance rules
end_of_line = lf
insert_final_newline = true

# Use UTF-8 encoding
charset = utf-8

# No trailing spaces or tabs at the end of lines
trim_trailing_whitespace = true

[*.nix]
# Use spaces as tab indents will have issues with Nix indented strings
indent_style = space

# Still using 4-space indents since I was never comfortable with Nix's 2-space default
indent_size = 4

[*.{yml,yaml}]
# YAML files do not accept tabs for indentation
indent_style = space
indent_size = 2

[*.lua]
# Use tab indents for Lua files
indent_style = tab
indent_size = 4

[{LICENSE,COPYING,TERMS}{,-*}{,.*}]
# Do not complain on license terms
end_of_line = unset
insert_final_newline = unset
charset = unset
trim_trailing_whitespace = unset
